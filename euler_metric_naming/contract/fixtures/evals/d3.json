 "protocol": {
  "schemaVersion": "2.0",
  "task": "depth.dense",
  "vocabularies": {
   "euler.core": "1.0",
   "euler.depth": "1.0",
   "euler.sky": "1.0"
  },
  "parameters": {
   "depth.alignment.mode": "auto_affine",
   "depth.alignment.applied": false,
   "depth.alignment.fit": "scale_shift",
   "depth.alignment.fit_trim": 0.0,
   "depth.input_space": "metric",
   "depth.cap.max_m": 38,
   "depth.benchmark.range_m": [
    0.01,
    32
   ],
   "depth.invalid.policy": "exclude_sentinel",
   "depth.conversion": "none",
   "sky.gt.masking": false,
   "sky.pred.masking": false,
   "sky.pred.fill": false,
   "spatial.method": "none",
   "spatial.policy": "auto",
   "spatial.resize_target": "gt_grid",
   "spatial.mask_resample": "nearest_exact"
  },
  "descriptors": {
   "reference.gt": {
    "label": "GT",
    "role": "reference",
    "description": "The ground truth the prediction is scored against.",
    "vocabulary": "euler.core@1.0"
   },
   "depth.alignment.mode": {
    "label": "depth alignment mode",
    "role": "provenance",
    "description": "Configured alignment mode (none, auto_affine, affine); whether a fit ran is depth.alignment.applied.",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.alignment.applied": {
    "label": "depth alignment applied",
    "role": "definition",
    "affects": {
     "axes": {
      "space": [
       "metric"
      ]
     }
    },
    "hint": "compare the native space, or two fitted runs",
    "description": "Whether a scale/shift fit to the GT produced the metric space.",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.alignment.fit": {
    "label": "depth alignment fit",
    "role": "definition",
    "appliesWhen": {
     "param": "depth.alignment.applied",
     "op": "eq",
     "value": true
    },
    "affects": {
     "axes": {
      "space": [
       "metric"
      ]
     }
    },
    "description": "The fitted model (e.g. scale, scale_shift, scale_shift_inverse).",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.alignment.fit_trim": {
    "label": "depth alignment trim",
    "role": "definition",
    "appliesWhen": {
     "param": "depth.alignment.applied",
     "op": "eq",
     "value": true
    },
    "affects": {
     "axes": {
      "space": [
       "metric"
      ]
     }
    },
    "description": "Fraction of largest residuals excluded from the fit.",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.input_space": {
    "label": "input depth space",
    "role": "provenance",
    "description": "Detected space of the prediction (metric, relative, affine).",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.cap.max_m": {
    "label": "depth cap",
    "role": "definition",
    "unit": "m",
    "inertIf": {
     "observation": "depth.cap.clipped",
     "op": "eq",
     "value": 0
    },
    "description": "Predictions (and filled predicted sky) are clipped at this depth; inert when nothing was clipped.",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.benchmark.range_m": {
    "label": "benchmark depth range",
    "role": "derived",
    "unit": "m",
    "derivedFrom": [],
    "description": "[min, max] GT depth of the benchmark bins; compared through the stratification it defines.",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.invalid.policy": {
    "label": "invalid-value policy",
    "role": "definition",
    "description": "How declared invalid sentinels are treated: exclude_sentinel (not scored) or score_sentinel.",
    "vocabulary": "euler.depth@1.0"
   },
   "depth.conversion": {
    "label": "depth conversion",
    "role": "definition",
    "description": "Conversion applied before scoring (none, radial_to_planar, planar_to_radial).",
    "vocabulary": "euler.depth@1.0"
   },
   "sky.gt.masking": {
    "label": "GT sky masking",
    "role": "definition",
    "description": "Pixels labelled sky in the GT segmentation are left out of every metric (--mask-sky).",
    "vocabulary": "euler.sky@1.0"
   },
   "sky.pred.masking": {
    "label": "predicted-sky masking",
    "role": "definition",
    "description": "Pixels in the prediction's own sky mask are left out of every metric (--mask-sky-prediction).",
    "vocabulary": "euler.sky@1.0"
   },
   "sky.pred.fill": {
    "label": "predicted-sky fill",
    "role": "definition",
    "appliesWhen": {
     "any": [
      {
       "param": "depth.cap.max_m",
       "op": "exists"
      },
      {
       "param": "sky.pred.masking",
       "op": "eq",
       "value": true
      }
     ]
    },
    "description": "Whether the prediction's sky mask was loaded and used (filled at the depth cap, or excluded under predicted-sky masking).",
    "vocabulary": "euler.sky@1.0"
   },
   "spatial.method": {
    "label": "spatial alignment",
    "role": "derived",
    "derivedFrom": [
     "prediction.resample",
     "spatial.gt_resample",
     "domain.region",
     "domain.grid"
    ],
    "description": "How prediction and GT resolutions were reconciled (none, crop, vae_crop, resize_prediction, resize, warp_prediction, warp, pointcloud_projection). Compared through the keys it is derived from.",
    "vocabulary": "euler.core@1.0"
   },
   "spatial.policy": {
    "label": "spatial alignment policy",
    "role": "provenance",
    "description": "The configured policy that chose the spatial method (e.g. auto, crop, resize, source_grid).",
    "vocabulary": "euler.core@1.0"
   },
   "spatial.resize_target": {
    "label": "resize target",
    "role": "definition",
    "appliesWhen": {
     "param": "spatial.method",
     "op": "in",
     "value": [
      "resize_prediction",
      "warp_prediction",
      "resize",
      "warp"
     ]
    },
    "description": "Which grid is resampled when resolutions differ and the prediction is not a crop: gt_grid (prediction onto GT) or prediction_grid (GT onto prediction).",
    "vocabulary": "euler.core@1.0"
   },
   "spatial.mask_resample": {
    "label": "mask resampling",
    "role": "definition",
    "appliesWhen": {
     "any": [
      {
       "param": "sky.gt.masking",
       "op": "eq",
       "value": true
      },
      {
       "param": "sky.pred.masking",
       "op": "eq",
       "value": true
      },
      {
       "param": "sky.pred.fill",
       "op": "eq",
       "value": true
      }
     ]
    },
    "description": "Interpolation used to resample masks (nearest, nearest_exact).",
    "vocabulary": "euler.core@1.0"
   },
   "domain.region": {
    "label": "domain",
    "role": "domain",
    "compare": "measure",
    "observe": "region",
    "unit": "px",
    "description": "The region of the source frame that was scored, as {frame, box: [top, left, height, width]} in source pixels.",
    "vocabulary": "euler.core@1.0"
   },
   "prediction.resample": {
    "label": "prediction resampled",
    "role": "domain",
    "compare": "measure",
    "observe": "factor",
    "default": [
     1,
     1
    ],
    "description": "Factor [height, width] by which the prediction was resampled onto the evaluated grid (target / source); [1, 1] when it was not.",
    "vocabulary": "euler.core@1.0"
   },
   "depth.cap.clipped": {
    "label": "clipped by depth cap",
    "role": "provenance",
    "observe": "fraction",
    "description": "Fraction of scored pixels whose prediction the depth cap changed.",
    "vocabulary": "euler.depth@1.0"
   }
  },
