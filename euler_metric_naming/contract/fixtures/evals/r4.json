  "descriptors": {
   "reference.gt": {
    "label": "GT",
    "role": "reference",
    "description": "The ground truth the prediction is scored against.",
    "vocabulary": "euler.core@1.0"
   },
   "rgb.fid.backend": {
    "label": "FID backend",
    "role": "definition",
    "affects": {
     "metrics": [
      "fid",
      "kid*"
     ]
    },
    "description": "Inception feature backend of FID/KID (builtin, clean-fid).",
    "vocabulary": "euler.rgb@1.0"
   },
   "rgb.depth_bins.policy": {
    "label": "depth-bin policy",
    "role": "definition",
    "affects": {
     "axes": {
      "family": [
       "depth_binned_photometric"
      ]
     }
    },
    "description": "Revision of how GT depth is put on the RGB grid for depth-binned photometric metrics (v1, v2).",
    "vocabulary": "euler.rgb@1.0"
   },
   "spatial.method": {
    "label": "spatial alignment",
    "role": "derived",
    "derivedFrom": [
     "prediction.resample",
     "spatial.gt_resample",
     "domain.region",
     "domain.grid"
    ],
    "description": "How prediction and GT resolutions were reconciled (none, crop, vae_crop, resize_prediction, resize, warp_prediction, warp, pointcloud_projection). Compared through the keys it is derived from.",
    "vocabulary": "euler.core@1.0"
   },
   "spatial.uniform": {
    "label": "uniform evaluated grid",
    "role": "definition",
    "description": "Whether every item was scored with the same spatial method on the same grid (same GT and prediction sizes, same crop origin). When false, spatial.method and the domain observations describe the first item only.",
    "vocabulary": "euler.core@1.0"
   }
  },
