{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d-rothen/euler-metric-naming/contract/training-naming-2.schema.json",
  "title": "Training naming declaration, schema 2",
  "description": "The metric_naming object of a training run's meta.json under training naming 2.0 (docs/training.md section 2). Unknown properties are allowed and ignored.",
  "type": "object",
  "required": [
    "schema_version",
    "namespaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "producer_key": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+\\.train$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "axes",
          "metrics"
        ],
        "properties": {
          "axes": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9_]+$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "position",
                "values"
              ],
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  }
                },
                "optional": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "axisRoles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "space",
                    "reduction",
                    "variant",
                    "family",
                    "stage",
                    "kind"
                  ]
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
            },
            "additionalProperties": {
              "$ref": "protocol-2.schema.json#/$defs/metricDefinition"
            }
          },
          "metricDescriptions": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
