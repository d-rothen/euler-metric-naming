{
  "$schema": "https://github.com/d-rothen/euler-metric-naming/contract/vocabulary-1.schema.json",
  "id": "euler.rgb",
  "version": "1.0",
  "title": "Euler RGB evaluation",
  "description": "RGB restoration and synthesis: full-reference, depth-binned, distribution and no-reference metrics.",
  "descriptors": {
    "rgb.fid.backend": {
      "label": "FID backend",
      "role": "definition",
      "affects": {
        "metrics": [
          "fid",
          "kid*"
        ]
      },
      "description": "Inception feature backend of FID/KID (builtin, clean-fid)."
    },
    "rgb.input.alignment": {
      "label": "input alignment",
      "role": "definition",
      "affects": {
        "metrics": [
          "hautiere_*"
        ]
      },
      "description": "How the input was put on the prediction grid (none, crop_input, upscale_input, upscale_prediction, warp_input)."
    },
    "rgb.input.alignment_policy": {
      "label": "input alignment policy",
      "role": "definition",
      "affects": {
        "metrics": [
          "hautiere_*"
        ]
      },
      "description": "Rule choosing the input alignment: upscale (always upscale the smaller side) or follow_gt (crop when the prediction is a crop)."
    },
    "rgb.depth_bins.policy": {
      "label": "depth-bin policy",
      "role": "definition",
      "affects": {
        "axes": {
          "family": [
            "depth_binned_photometric"
          ]
        }
      },
      "description": "Revision of how GT depth is put on the RGB grid for depth-binned photometric metrics (v1, v2)."
    },
    "rgb.depth_bins.edges_m": {
      "label": "photometric depth bins",
      "role": "definition",
      "unit": "m",
      "affects": {
        "axes": {
          "family": [
            "depth_binned_photometric"
          ]
        }
      },
      "description": "[near, far] thresholds of the fixed depth bins of depth-binned photometric metrics (euler-eval: [1, 5])."
    }
  },
