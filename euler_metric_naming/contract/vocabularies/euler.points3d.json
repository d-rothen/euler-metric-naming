{
  "$schema": "https://github.com/d-rothen/euler-metric-naming/contract/vocabulary-1.schema.json",
  "id": "euler.points3d",
  "version": "1.0",
  "title": "Euler point-map evaluation",
  "description": "Dense and sparse 3D point maps: gauge alignment, point errors and cloud distances.",
  "descriptors": {
    "points3d.alignment.mode": {
      "label": "point-map alignment mode",
      "role": "provenance",
      "description": "Configured gauge alignment (none, scale, similarity, auto)."
    },
    "points3d.alignment.applied": {
      "label": "point-map alignment applied",
      "role": "definition",
      "affects": {
        "axes": {
          "space": [
            "metric"
          ]
        }
      },
      "hint": "compare the native space, or two aligned runs",
      "description": "Whether a gauge alignment produced the metric space (auto that resolved to none counts as not applied)."
    },
    "points3d.f_a.threshold_m": {
      "label": "F_A threshold",
      "role": "definition",
      "unit": "m",
      "affects": {
        "metrics": [
          "f_a*"
        ]
      },
      "description": "Distance threshold up to which F_A integrates the F-score curve."
    }
  },
  "metrics": {
