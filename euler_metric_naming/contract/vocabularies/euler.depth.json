{
  "$schema": "https://github.com/d-rothen/euler-metric-naming/contract/vocabulary-1.schema.json",
  "id": "euler.depth",
  "version": "1.0",
  "title": "Euler depth evaluation",
  "description": "Dense and sparse depth: alignment, depth cap, invalid values, benchmark bins and the depth metrics.",
  "descriptors": {
    "depth.alignment.mode": {
      "label": "depth alignment mode",
      "role": "provenance",
      "description": "Configured alignment mode (none, auto_affine, affine); whether a fit ran is depth.alignment.applied."
    },
    "depth.alignment.applied": {
      "label": "depth alignment applied",
      "role": "definition",
      "affects": {
        "axes": {
          "space": [
            "metric"
          ]
        }
      },
      "hint": "compare the native space, or two fitted runs",
      "description": "Whether a scale/shift fit to the GT produced the metric space."
    },
    "depth.alignment.fit": {
      "label": "depth alignment fit",
      "role": "definition",
      "appliesWhen": {
        "param": "depth.alignment.applied",
        "op": "eq",
        "value": true
      },
      "affects": {
        "axes": {
          "space": [
            "metric"
          ]
        }
      },
      "description": "The fitted model (e.g. scale, scale_shift, scale_shift_inverse)."
    },
    "depth.alignment.fit_trim": {
      "label": "depth alignment trim",
      "role": "definition",
      "appliesWhen": {
        "param": "depth.alignment.applied",
        "op": "eq",
        "value": true
      },
      "affects": {
        "axes": {
          "space": [
            "metric"
          ]
        }
      },
      "description": "Fraction of largest residuals excluded from the fit."
    },
    "depth.input_space": {
      "label": "input depth space",
      "role": "provenance",
      "description": "Detected space of the prediction (metric, relative, affine)."
    },
    "depth.cap.max_m": {
      "label": "depth cap",
      "role": "definition",
      "unit": "m",
      "inertIf": {
        "observation": "depth.cap.clipped",
        "op": "eq",
        "value": 0
      },
      "description": "Predictions (and filled predicted sky) are clipped at this depth; inert when nothing was clipped."
    },
    "depth.cap.clipped": {
      "label": "clipped by depth cap",
      "role": "provenance",
      "observe": "fraction",
      "description": "Fraction of scored pixels whose prediction the depth cap changed."
    },
    "depth.benchmark.range_m": {
      "label": "benchmark depth range",
      "role": "derived",
      "unit": "m",
      "derivedFrom": [],
      "description": "[min, max] GT depth of the benchmark bins; compared through the stratification it defines."
    },
    "depth.invalid.policy": {
      "label": "invalid-value policy",
      "role": "definition",
      "description": "How declared invalid sentinels are treated: exclude_sentinel (not scored) or score_sentinel."
    },
    "depth.conversion": {
      "label": "depth conversion",
      "role": "definition",
      "description": "Conversion applied before scoring (none, radial_to_planar, planar_to_radial)."
    }
  },
